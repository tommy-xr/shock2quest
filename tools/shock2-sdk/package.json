{
  "name": "@shock2vr/sdk",
  "version": "0.1.0",
  "description": "Playwright-style TypeScript SDK for driving the shock2vr debug runtime",
  "type": "module",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/check-deps.mjs",
    "build": "tsc",
    "pretest": "node scripts/check-deps.mjs",
    "test": "tsc && node scripts/run-tests.mjs \"dist/test/*.test.js\"",
    "pretest:e2e": "node scripts/check-deps.mjs && npm run clean:saves",
    "test:e2e": "tsc && SHOCK2_E2E=1 node scripts/run-tests.mjs --test-concurrency=1 \"dist/test/*.test.js\"",
    "pretest:e2e:reliability": "node scripts/check-deps.mjs",
    "test:e2e:reliability": "tsc && node scripts/reliability.mjs",
    "preanim-smoothness": "node scripts/check-deps.mjs",
    "anim-smoothness": "tsc && node dist/scripts/anim-smoothness.js",
    "clean:saves": "tsc && node scripts/clean-test-saves.mjs",
    "posttest:e2e": "node scripts/clean-test-saves.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
