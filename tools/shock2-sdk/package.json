{
  "name": "@shock2vr/sdk",
  "version": "0.1.0",
  "description": "Playwright-style TypeScript SDK for driving the shock2vr debug runtime",
  "type": "module",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "test:e2e": "tsc && SHOCK2_E2E=1 node --test --test-concurrency=1 \"dist/test/*.test.js\"",
    "test:e2e:reliability": "tsc && node scripts/reliability.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
